generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id        String       @id @default(cuid())
  name      String
  location  String?
  summary   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  skills    Skill[]
  interests Interest[]
  careerPaths CareerPath[]

  @@map("user_profiles")
}

model Skill {
  id           String       @id @default(cuid())
  name         String
  category     String?
  proficiency  String?
  userProfileId String
  userProfile  UserProfile  @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId])
  @@map("skills")
}

model Interest {
  id           String      @id @default(cuid())
  name         String
  description  String?
  userProfileId String
  userProfile  UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId])
  @@map("interests")
}

model CareerPath {
  id           String      @id @default(cuid())
  title        String
  description  String?
  status       String      @default("ACTIVE")
  userProfileId String
  userProfile  UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId])
  @@map("career_paths")
}

model Source {
  id                String    @id @default(cuid())
  name              String
  url               String
  category          String
  country           String?
  collectionMethod  String?
  status            String    @default("ACTIVE")
  frequency         String?
  reliability       Int?
  lastSuccessfulRun DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  jobs              Job[]

  @@index([status])
  @@index([category])
  @@map("sources")
}

model Job {
  id               String    @id @default(cuid())
  title            String
  company          String
  location         String?
  url              String
  description      String?
  employmentType   String?
  salaryMin        Int?
  salaryMax        Int?
  currency         String?
  publishedAt      DateTime?
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  lastVerifiedAt   DateTime?
  expiresAt        DateTime?
  status           String    @default("NEW")
  sourceId         String
  source           Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  matches          JobMatch[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([sourceId])
  @@index([publishedAt])
  @@index([company])
  @@map("jobs")
}

model JobMatch {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  score     Float
  explanation String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([status])
  @@map("job_matches")
}
